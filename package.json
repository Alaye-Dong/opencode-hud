{
  "name": "opencode-hud",
  "version": "0.1.5",
  "type": "module",
  "description": "OpenCode plugin that displays TPS, TTFT, and token metrics at conversation end.",
  "author": "alaye-dong",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./server": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./config": {
      "import": "./dist/config-entry.js",
      "types": "./dist/config-entry.d.ts"
    }
  },
  "oc-plugin": ["server"],
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "prepublishOnly": "bun run typecheck && bun test && bun run build"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tps",
    "ttft",
    "metrics",
    "ai",
    "llm"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@opencode-ai/plugin": ">=0.1.0",
    "@opencode-ai/sdk": ">=0.1.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.3.5",
    "@opencode-ai/sdk": "^1.3.5",
    "typescript": "^5.9.3",
    "bun-types": "latest",
    "@types/bun": "latest"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Alaye-Dong/opencode-hud.git"
  }
}
